# PostgreSQL existente (produção/desenvolvimento) - acesso somente leitura
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# CORS - origem(ns) do frontend permitidas em desenvolvimento
CORS_ORIGINS=http://localhost:3000

# brapi.dev - usado exclusivamente pelo backend (nunca exposto ao frontend)
BRAPI_API_TOKEN=
BRAPI_BASE_URL=https://brapi.dev
BRAPI_TIMEOUT_SECONDS=15.0

# Horario (HH:MM, hora local de quem roda o processo) em que
# app/scripts/run_scheduler.py dispara a atualizacao diaria de mercado.
DAILY_UPDATE_TIME=03:00

# Testes (backend/tests/conftest.py) - Postgres local descartável, nada a ver
# com o banco real. Opcional: só necessário se o padrão abaixo não servir
# (ex.: outro host/porta/usuário local, container de CI). Ver README "Rodar
# os testes" para o setup do banco local.
# ARGOS_TEST_DATABASE_URL=postgresql+psycopg2://argos_test:argos_test@localhost:5432/argos_test
